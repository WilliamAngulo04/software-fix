# Copia este archivo como .env (en esta misma carpeta, junto a manage.py) y ajusta los valores.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
TIME_ZONE=America/Bogota

# --- Base de datos (elige UNA opción) ---
# Opción A: PostgreSQL en la nube (Supabase, Neon…). Es la que usa Vercel.
# DATABASE_URL=postgresql://usuario:contraseña@host:6543/postgres

# Opción B: PostgreSQL local.
# DB_NAME=software_fix
# DB_USER=postgres
# DB_PASSWORD=tu_contraseña
# DB_HOST=localhost
# DB_PORT=5432

# Sin ninguna de las dos se usa SQLite (solo para pruebas).

# --- Fotos en almacenamiento S3 (obligatorio en Vercel; opcional en local) ---
# S3_BUCKET=evidencias
# S3_ENDPOINT_URL=https://xxxx.storage.supabase.co/storage/v1/s3
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Solo con dominio propio ---
# ALLOWED_HOSTS=localhost,127.0.0.1,midominio.com
# CSRF_TRUSTED_ORIGINS=https://midominio.com
